<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget ground. Radius 12 is the list-section radius (DESIGN_SPEC §2.8) and the
     1dp mem_widget_outline hairline is the boundary token (§2.7) — the widget is a bounded
     surface sitting on someone else's wallpaper, so it needs the boundary, not the divider.
     Colours are night-invariant on purpose; see values/colors.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/mem_widget_surface"/>
    <corners android:radius="12dp"/>
    <stroke android:width="1dp" android:color="@color/mem_widget_outline"/>
    <padding android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp"/>
</shape>
