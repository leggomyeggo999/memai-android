<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon and splash glyph: the electric-blue brain on the true-black canvas.
     Colours are night-INVARIANT (see values/colors.xml) — this drawable is rasterised by the
     launcher, which does not follow the app's appearance setting.

     The layer geometry is authored against a 140dp square: every child inset below is an absolute
     dp offset from the drawable bounds, so the base shape declares that size to give the whole
     layer-list an intrinsic size. Without it the drawable reports -1 x -1 and any host that sizes
     it from its intrinsics (the splash layer-list, bitmap rasterisers) stretches the geometry. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="140dp" android:height="140dp" />
            <corners android:radius="22dp" />
            <solid android:color="@color/mem_brand_canvas" />
        </shape>
    </item>

    <item android:left="22dp" android:top="18dp" android:right="22dp" android:bottom="26dp">
        <shape android:shape="oval">
            <solid android:color="@color/mem_brand_primary" />
        </shape>
    </item>

    <item android:left="34dp" android:top="48dp" android:right="34dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/mem_brand_primary" />
        </shape>
    </item>

    <!-- The remaining layers are cut-outs: they are painted in the tile colour so they read as
         negative space carved out of the glyph. They must track mem_brand_canvas exactly. -->
    <item android:left="34dp" android:top="28dp" android:right="60dp" android:bottom="38dp">
        <shape android:shape="oval">
            <solid android:color="@color/mem_brand_canvas" />
        </shape>
    </item>
    <item android:left="60dp" android:top="28dp" android:right="34dp" android:bottom="38dp">
        <shape android:shape="oval">
            <solid android:color="@color/mem_brand_canvas" />
        </shape>
    </item>

    <item android:left="48dp" android:top="16dp" android:right="66dp" android:bottom="48dp">
        <shape android:shape="oval">
            <solid android:color="@color/mem_brand_canvas" />
        </shape>
    </item>
    <item android:left="66dp" android:top="16dp" android:right="48dp" android:bottom="48dp">
        <shape android:shape="oval">
            <solid android:color="@color/mem_brand_canvas" />
        </shape>
    </item>
</layer-list>
